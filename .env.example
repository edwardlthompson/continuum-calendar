# Environment variables (copy to .env / apps/desktop/.env and fill in)
# Never commit .env — it is gitignored.

# Template update checker upstream (optional override)
# TEMPLATE_UPSTREAM=edwardlthompson/agent-project-bootstrap

# Google OAuth (desktop) — see docs/GOOGLE_API_SETUP.md
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
# Web/Vite fallback only. Tauri uses a one-shot http://127.0.0.1:<port>/ loopback.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

# Optional
# API_BASE_URL=http://localhost:3000
# LOG_LEVEL=info

# Android upload keystore (file stays outside git; see docs/ANDROID_SIGNING.md)
# GOLDENPATH_UPLOAD_STORE_FILE=/absolute/path/to/upload.jks
# GOLDENPATH_UPLOAD_STORE_PASSWORD=
# GOLDENPATH_UPLOAD_KEY_ALIAS=upload
# GOLDENPATH_UPLOAD_KEY_PASSWORD=

# Continuum mobile (apps/mobile) — preferred: gitignored apps/mobile/keystore.properties
# SIGNING_STORE_FILE=$HOME/keys/continuum-release.jks
# SIGNING_STORE_PASSWORD=
# SIGNING_KEY_ALIAS=continuum
# SIGNING_KEY_PASSWORD=
