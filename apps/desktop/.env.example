# Google OAuth — from Google Cloud Console → Credentials
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
# Required for token exchange with most Google OAuth clients (including Desktop).
VITE_GOOGLE_CLIENT_SECRET=
# Web/Vite fallback only. Tauri uses a one-shot http://127.0.0.1:<port>/ loopback.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback
