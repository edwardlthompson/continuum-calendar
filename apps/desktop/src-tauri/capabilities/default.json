{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-start-oauth-loopback",
    "allow-google-oauth-token",
    "allow-take-pending-open-paths",
    "allow-read-text-file-limited"
  ]
}