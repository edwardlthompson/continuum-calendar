{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-start-oauth-loopback",
    "allow-google-oauth-token",
    "allow-save-google-tokens",
    "allow-load-google-tokens",
    "allow-open-external-url",
    "allow-take-pending-open-paths",
    "allow-read-text-file-limited",
    "allow-suggest-locations",
    "allow-set-day-badge",
    "allow-set-window-behavior",
    "allow-claim-default-calendar",
    "allow-is-default-calendar",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
